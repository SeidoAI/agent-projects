# Per-project workflow definitions (v0.13 schema).
#
# Routes are the single source of structural arrows. Status nodes
# declare territory (artifacts produced/consumed, controls fired on
# entry); routes declare transitions with their gates, side-effects,
# and rollback policy. The executor (`tripwire.core.workflow.transitions`)
# is the SOLE writer of `session.status` — every direct mutation in
# the codebase routes through `execute_transition` with a route id.
#
# Conditional triggers are equality only (`==`, `!=`). Predicate
# fields are dot-paths into the workflow context.
#
# v0.13.1 adds the `instance:` block on every workflow, declaring the
# runtime instance shape (storage path, status field, status enum,
# required fields). `tripwire validate` enforces these contracts
# uniformly. Only `coding-session` is executor-driven today; the other
# workflow declarations are reference shapes for the PM-conversational
# routes catalogued in `docs/WORKFLOW_ACTIONS.md`.

workflow_schema_version: 1

workflows:
  coding-session:
    actor: coding-agent
    trigger: session.spawn
    brief-description: "one session: plan, execute, review, ship."
    instance:
      storage_path: instances/sessions/{instance_id}/session.yaml
      status_field: status
      status_enum:
        - planned
        - queued
        - executing
        - in_review
        - verified
        - completed
        - paused
        - failed
        - abandoned
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: planned
        artifacts:
          consumes:
            - id: issue-brief
              label: issue brief
          produces:
            - id: plan
              label: plan.md
              path: instances/sessions/{session_id}/artifacts/plan.md
            - id: verification-checklist
              label: verification-checklist.md
              path: instances/sessions/{session_id}/artifacts/verification-checklist.md
        work_steps:
          - id: plan
            actor: pm-agent
            label: write plan + verification checklist
            skills: [project-manager, verification]
      - id: queued
        artifacts:
          consumes:
            - id: plan
              label: plan.md
            - id: verification-checklist
              label: verification-checklist.md
        work_steps:
          - id: dispatch
            actor: pm-agent
            label: dispatch when unblocked
            skills: [project-manager]
      - id: executing
        artifacts:
          consumes:
            - id: plan
              label: plan.md
            - id: verification-checklist
              label: verification-checklist.md
          produces:
            - id: diff
              label: implementation diff
            - id: task-checklist
              label: task-checklist.md
              path: instances/sessions/{session_id}/artifacts/task-checklist.md
            - id: self-review
              label: self-review.md
              path: instances/sessions/{session_id}/artifacts/self-review.md
            - id: recommended-testing-plan
              label: recommended-testing-plan.md
              path: instances/sessions/{session_id}/artifacts/recommended-testing-plan.md
            - id: post-completion-comments
              label: post-completion-comments.md
              path: instances/sessions/{session_id}/artifacts/post-completion-comments.md
            - id: developer-doc
              label: developer.md
              path: instances/issues/{issue_key}/docs/developer.md
            - id: tripwire-pr
              label: tripwire-repo PR
            - id: project-pr
              label: project-repo PR
        work_steps:
          - id: monitor
            actor: pm-agent
            label: monitor execution
            skills: [project-manager]
          - id: implement
            actor: coding-agent
            label: implement
            skills: [backend-development, agent-messaging]
          - id: deliver
            actor: coding-agent
            label: open PRs + self-review
            skills: [verification]
      - id: in_review
        artifacts:
          consumes:
            - id: diff
              label: implementation diff
            - id: self-review
              label: self-review.md
            - id: task-checklist
              label: task-checklist.md
            - id: recommended-testing-plan
              label: recommended-testing-plan.md
            - id: tripwire-pr
              label: tripwire-repo PR
            - id: project-pr
              label: project-repo PR
          produces:
            - id: pm-response
              label: pm-response.yaml
              path: instances/sessions/{session_id}/artifacts/pm-response.yaml
        work_steps:
          - id: review
            actor: pm-agent
            label: review session
            skills: []
      - id: verified
        artifacts:
          consumes:
            - id: pm-response
              label: pm-response.yaml
            - id: self-review
              label: self-review.md
          produces:
            - id: completion-comment
              label: completion-comment.yaml
              path: instances/issues/{issue_key}/docs/comments/{nnn}-completion-{yyyy-mm-dd}.yaml
        work_steps:
          - id: close-out
            actor: pm-agent
            label: write completion comment
            skills: [project-manager, agent-messaging]
      - id: completed
        terminal: true
        artifacts:
          consumes:
            - id: tripwire-pr
              label: tripwire-repo PR
            - id: project-pr
              label: project-repo PR
          produces:
            - id: session-signature
              label: session signature
        work_steps:
          - id: sign
            actor: code
            label: sign session
            skills: []
      - id: paused
      - id: failed
      - id: abandoned
        terminal: true
    routes:
      # Forward path
      - id: session-create
        actor: pm-agent
        command: pm-session-create
        trigger: command.pm-session-create
        from: source:issue
        to: planned
        kind: forward
        label: create session
        controls:
          prompt_checks: [pm-session-create]
          tripwires:
            - v_workflow_well_formed
            - v_uuid_present
            - v_id_format
            - v_enum_values
            - v_id_collisions
            - v_timestamps
          heuristics:
            - v_sequence_drift
        skills: [project-manager]
        emits:
          artifacts:
            - id: session-yaml
              label: session.yaml
      - id: planned-to-queued
        actor: pm-agent
        command: pm-session-queue
        trigger: command.pm-session-queue
        from: planned
        to: queued
        kind: forward
        label: queue session
        controls:
          prompt_checks: [pm-session-queue]
          tripwires:
            - v_session_issue_coherence
            - v_issue_session_status_compatibility
            - v_reference_integrity
            - v_bidirectional_related
            - v_no_stale_pins
            - v_status_transitions
        skills: [project-manager]
        side_effects: [sweep_issues_forward]
        emits:
          artifacts:
            - id: plan
              label: plan.md
      - id: queued-to-executing
        actor: pm-agent
        command: pm-session-spawn
        trigger: command.pm-session-spawn
        from: queued
        to: executing
        kind: forward
        label: spawn coding agent
        controls:
          prompt_checks: [pm-session-spawn]
          tripwires:
            - v_issue_body_structure
            - v_project_standards
            - v_freshness
            - v_comment_provenance
            - v_handoff_artifact
            - v_worktree_paths_unique
            - v_no_orphan_proj_branches
            - v_done_implies_session_completed
          heuristics:
            - v_stale_concept
            - v_concept_name_prose
            - v_semantic_coverage
            - v_mega_issue
            - v_node_ratio
        skills: [project-manager, backend-development, agent-messaging]
        emits:
          events: [session.spawn]
      - id: executing-to-in_review
        actor: coding-agent
        trigger: command.tripwire-session-complete
        from: executing
        to: in_review
        kind: forward
        label: submit for review
        controls:
          tripwires:
            - v_manifest_schema
            - v_manifest_phase_ownership_consistent
            - v_artifact_presence
            - v_phase_requirements
            - v_issue_artifact_presence
          heuristics:
            - v_coverage_heuristics
            - v_quality_consistency
        skills: [backend-development, agent-messaging]
        side_effects: [sweep_issues_forward, rebase_pt_branch]
        emits:
          artifacts:
            - id: diff
              label: implementation diff
      - id: review-approved
        actor: pm-agent
        command: pm-session-review
        trigger: review.outcome == approved
        from: in_review
        to: verified
        kind: forward
        label: approve review
        controls:
          prompt_checks: [pm-session-review]
          tripwires:
            - v_pr_review_evidence
            - v_pr_review_threshold_findings
            - v_pr_review_external_reviewer
            - v_pr_review_code_review_skill
        skills: [project-manager, verification]
        side_effects: [sweep_issues_forward]
        emits:
          artifacts:
            - id: review-notes
              label: review notes
      - id: review-changes-requested
        actor: pm-agent
        command: pm-session-review
        trigger: review.outcome == changes_requested
        from: in_review
        to: executing
        kind: revert
        label: request changes
        skills: [project-manager, verification, backend-development]
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: verified-to-in_review
        actor: pm-agent
        from: verified
        to: in_review
        kind: revert
        label: re-open review (verified→in_review)
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: verified-to-completed
        actor: pm-agent
        command: pm-session-complete
        trigger: command.pm-session-complete
        from: verified
        to: completed
        kind: forward
        label: complete session
        controls:
          prompt_checks: [pm-session-complete]
          tripwires:
            - v_pm_response_covers_self_review
            - v_pm_response_followups_resolve
            - v_done_implies_issue_artifacts_on_main
            - v_self_review_implies_pm_response
            - v_pr_merged_for_session
            - v_pr_review_approved
            - v_session_has_developer_md
            - v_session_has_verified_md
          jit_prompts:
            - self-review
            - phase-transition
            - followups-not-filed
            - stopped-to-ask
            - write-count
            - cost-ceiling
        skills: [project-manager, verification]
        side_effects:
          - flip_drafts_to_ready
          - sweep_issues_forward
          - remove_worktrees
          - close_active_engagement
          - append_telemetry_row
        emits:
          artifacts:
            - id: session-signature
              label: session signature

      # Side-state edges (off-path). These routes are triggered by CLI
      # commands (`tripwire session pause/abandon/reopen`) or runtime
      # events (e.g. process exit) — not by slash-command invocations,
      # so they do not declare `command:` (no prompt-check coverage).
      - id: executing-to-paused
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-pause
        from: executing
        to: paused
        kind: side
        label: pause execution
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: executing-to-failed
        actor: code
        trigger:
          type: runtime_event
          name: process_exited
        from: executing
        to: failed
        kind: side
        label: runtime exited unexpectedly
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
        side_effects:
          - close_active_engagement
      - id: paused-to-executing
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-spawn-resume
        from: paused
        to: executing
        kind: forward
        label: resume from paused
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: failed-to-executing
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-spawn-resume
        from: failed
        to: executing
        kind: forward
        label: resume from failed
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: paused-to-queued
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-requeue
        from: paused
        to: queued
        kind: revert
        label: re-queue paused session (PM-handoff #5 Gap C fix)
        preserve_fields:
          - runtime_state.claude_session_id
      - id: paused-to-completed
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-unreopen
        from: paused
        to: completed
        kind: revert
        label: never mind, leave completed (PM-handoff #5 Gap D fix)
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
        side_effects:
          - close_active_engagement

      # Reopen (completed → paused) — PM-handoff #5 Gap A path.
      - id: completed-to-paused-reopen
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-reopen
        from: completed
        to: paused
        kind: revert
        label: reopen completed session
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
        side_effects:
          - flip_drafts_to_draft
          - append_pm_followup_stub
          - reset_acks
          - append_audit_log_entry
        emits:
          events: [session.reopened]

      # Abandon edges from every non-terminal status. Triggered by
      # `tripwire session abandon` (CLI), not a slash command.
      - id: planned-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: planned
        to: abandoned
        kind: side
        label: abandon (planned)
        side_effects:
          - close_active_engagement
      - id: queued-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: queued
        to: abandoned
        kind: side
        label: abandon (queued)
        side_effects:
          - close_active_engagement
      - id: executing-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: executing
        to: abandoned
        kind: side
        label: abandon (executing)
        side_effects:
          - close_active_engagement
          - kill_runtime
          - close_open_prs
          - remove_worktrees
      - id: paused-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: paused
        to: abandoned
        kind: side
        label: abandon (paused)
        side_effects:
          - close_active_engagement
          - close_open_prs
          - remove_worktrees
      - id: failed-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: failed
        to: abandoned
        kind: side
        label: abandon (failed)
        side_effects:
          - close_active_engagement
          - close_open_prs
          - remove_worktrees
      - id: in_review-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: in_review
        to: abandoned
        kind: side
        label: abandon (in_review)
        side_effects:
          - close_active_engagement
          - close_open_prs
          - remove_worktrees
      - id: verified-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: verified
        to: abandoned
        kind: side
        label: abandon (verified)
        side_effects:
          - close_active_engagement
          - close_open_prs
          - remove_worktrees

  # ------------------------------------------------------------------
  # Reference-only workflows (no executor coverage in v0.13).
  #
  # The blocks below declare the PM/review/ops process shape so
  # `tripwire validate` can lint them and the renderer can draw them.
  # They are NOT driven by the executor — no `WORKFLOW_ID` is
  # registered, no route mutates an instance via `execute_transition`.
  # The agent drives these workflows conversationally per the skill
  # markdown; the declarations here are the contract those paths follow.
  #
  # `instance:` blocks are starting points — most reference workflows
  # do not yet have a persisted instance model. Paths are declared
  # aspirationally; the executor will materialise them in a later
  # release (or the workflow will be folded into another flow).
  # ------------------------------------------------------------------

  pm-scoping:
    actor: pm-agent
    trigger: command.pm-scope
    instance:
      storage_path: instances/scoping-runs/{instance_id}/scoping.yaml
      status_field: status
      status_enum: [queued, drafting, refining, ready, abandoned]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: intake
        work_steps:
          - id: capture
            actor: pm-agent
            label: capture intent
            skills: [project-manager]
      - id: draft
        heuristics:
          - v_mega_issue
          - v_concept_name_prose
          - v_semantic_coverage
          - v_quality_consistency
        work_steps:
          - id: draft
            actor: pm-agent
            label: draft scoped issues
            skills: [project-manager]
      - id: validate
        tripwires:
          - v_uuid_present
          - v_id_format
          - v_id_collisions
          - v_reference_integrity
        heuristics:
          - v_sequence_drift
        prompt_checks: [pm-validate]
        work_steps:
          - id: validate
            actor: code
            label: validate scope
            skills: [project-manager]
      - id: publish
        terminal: true
        tripwires:
          - v_phase_requirements
          - v_done_implies_session_completed
        prompt_checks: [pm-scope]
        cross_links:
          - workflow: pm-triage
            status: intake
            label: scoped issues enter triage
            kind: triggers
        work_steps:
          - id: publish
            actor: pm-agent
            label: publish scoped issues
            skills: [project-manager]
    routes:
      - id: scope-intake
        actor: pm-agent
        command: pm-scope
        trigger: command.pm-scope
        from: source:intent
        to: intake
        kind: forward
        label: intake intent
        skills: [project-manager]
      - id: draft-scope
        actor: pm-agent
        command: pm-scope
        trigger: scoping.draft
        from: intake
        to: draft
        kind: forward
        label: draft artifacts
        skills: [project-manager]
      - id: validate-scope
        actor: code
        command: pm-validate
        trigger: command.pm-validate
        from: draft
        to: validate
        kind: forward
        label: validate scope
        skills: [project-manager]
      - id: scope-gap-loop
        actor: pm-agent
        command: pm-rescope
        trigger: gaps.present == true
        from: validate
        to: draft
        kind: return
        label: close gaps
        skills: [project-manager]
      - id: publish-scope
        actor: pm-agent
        command: pm-scope
        trigger: gaps.present == false
        from: validate
        to: publish
        kind: forward
        label: publish
        skills: [project-manager]

  pm-triage:
    actor: pm-agent
    trigger: command.pm-triage
    instance:
      storage_path: instances/triage-runs/{instance_id}/triage.yaml
      status_field: status
      status_enum: [queued, triaging, resolved, escalated, dismissed]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: intake
        work_steps:
          - id: receive
            actor: pm-agent
            label: receive inbox item
            skills: [project-manager, agent-messaging]
      - id: classify
        heuristics:
          - v_mega_issue
        work_steps:
          - id: classify
            actor: pm-agent
            label: classify item
            skills: [project-manager]
      - id: act
        tripwires:
          - v_reference_integrity
        prompt_checks: [pm-edit]
        cross_links:
          - workflow: coding-session
            status: planned
            label: triages into session
            kind: triggers
        work_steps:
          - id: act
            actor: pm-agent
            label: act on classification
            skills: [project-manager]
      - id: close
        terminal: true
        tripwires:
          - v_done_implies_session_completed
        work_steps:
          - id: close
            actor: pm-agent
            label: close triage record
            skills: [project-manager]
    routes:
      - id: triage-intake
        actor: pm-agent
        command: pm-triage
        trigger: command.pm-triage
        from: source:inbox
        to: intake
        kind: forward
        label: intake
        skills: [project-manager, agent-messaging]
      - id: classify-item
        actor: pm-agent
        command: pm-triage
        trigger: triage.classify
        from: intake
        to: classify
        kind: forward
        label: classify
        skills: [project-manager]
      - id: act-on-item
        actor: pm-agent
        command: pm-edit
        trigger: triage.action
        from: classify
        to: act
        kind: forward
        label: act
        skills: [project-manager]
      - id: close-triage
        actor: pm-agent
        command: pm-triage
        trigger: triage.close
        from: act
        to: close
        kind: forward
        label: close
        skills: [project-manager]

  pm-incremental-update:
    actor: pm-agent
    trigger: command.pm-edit
    instance:
      storage_path: instances/update-runs/{instance_id}/update.yaml
      status_field: status
      status_enum: [proposed, applied, rejected]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: inspect
        work_steps:
          - id: inspect
            actor: pm-agent
            label: inspect change request
            skills: [project-manager]
      - id: edit
        heuristics:
          - v_concept_name_prose
          - v_quality_consistency
        work_steps:
          - id: edit
            actor: pm-agent
            label: apply edits
            skills: [project-manager]
      - id: validate
        tripwires:
          - v_uuid_present
          - v_id_format
          - v_reference_integrity
        prompt_checks: [pm-validate]
        work_steps:
          - id: validate
            actor: code
            label: validate edits
            skills: [project-manager]
      - id: publish
        terminal: true
        tripwires:
          - v_phase_requirements
          - v_done_implies_session_completed
        prompt_checks: [pm-issue-close]
        cross_links:
          - workflow: coding-session
            status: planned
            label: incremental update spawns session
            kind: triggers
          - workflow: issue-closure
            status: verified
            label: pm-issue-close path
            kind: triggers
        work_steps:
          - id: publish
            actor: pm-agent
            label: publish update
            skills: [project-manager]
    routes:
      - id: inspect-update
        actor: pm-agent
        command: pm-edit
        trigger: command.pm-edit
        from: source:change-request
        to: inspect
        kind: forward
        label: inspect
        skills: [project-manager]
      - id: apply-update
        actor: pm-agent
        command: pm-edit
        trigger: update.apply
        from: inspect
        to: edit
        kind: forward
        label: edit
        skills: [project-manager]
      - id: validate-update
        actor: code
        command: pm-validate
        trigger: command.pm-validate
        from: edit
        to: validate
        kind: forward
        label: validate
        skills: [project-manager]
      - id: fix-update-loop
        actor: pm-agent
        command: pm-edit
        trigger: validation.clean == false
        from: validate
        to: edit
        kind: return
        label: fix
        skills: [project-manager]
      - id: publish-update
        actor: pm-agent
        command: pm-issue-close
        trigger: validation.clean == true
        from: validate
        to: publish
        kind: forward
        label: publish
        skills: [project-manager]

  project-maintenance:
    actor: pm-agent
    trigger: command.pm-status
    instance:
      storage_path: instances/maintenance-runs/{instance_id}/maintenance.yaml
      status_field: status
      status_enum: [scheduled, running, done, failed]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: inspect
        heuristics:
          - v_stale_concept
          - v_node_ratio
          - v_quality_consistency
        work_steps:
          - id: inspect
            actor: pm-agent
            label: inspect project state
            skills: [project-manager]
      - id: report
        terminal: true
        prompt_checks: [pm-agenda]
        cross_links:
          - workflow: pm-triage
            status: intake
            label: maintenance findings enter triage
            kind: triggers
        work_steps:
          - id: report
            actor: pm-agent
            label: emit findings
            skills: [project-manager]
    routes:
      - id: status-report
        actor: pm-agent
        command: pm-status
        trigger: command.pm-status
        from: source:project
        to: inspect
        kind: forward
        label: status
        skills: [project-manager]
      - id: agenda-report
        actor: pm-agent
        command: pm-agenda
        trigger: command.pm-agenda
        from: inspect
        to: report
        kind: forward
        label: agenda
        skills: [project-manager]
      - id: graph-report
        actor: pm-agent
        command: pm-graph
        trigger: command.pm-graph
        from: inspect
        to: report
        kind: side
        label: graph
        skills: [project-manager]
      - id: validate-report
        actor: code
        command: pm-validate
        trigger: command.pm-validate
        from: inspect
        to: report
        kind: side
        label: validate
        skills: [project-manager]
      - id: sync-project
        actor: code
        command: pm-project-sync
        trigger: command.pm-project-sync
        from: inspect
        to: report
        kind: side
        label: sync
        skills: [project-manager]

  # pm-monitor — overseer loop. Scans project state, classifies signals,
  # and dispatches actions or subagents per the cross_link contract.
  pm-monitor:
    actor: pm-agent
    trigger: command.pm-monitor
    instance:
      storage_path: instances/monitor-runs/{instance_id}/monitor.yaml
      status_field: status
      status_enum: [running, done, failed]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: scan
        tripwires:
          - v_workflow_well_formed
        work_steps:
          - id: gather-session-state
            actor: pm-agent
            label: gather session state
            skills: [project-manager]
          - id: gather-pr-state
            actor: pm-agent
            label: gather PR state
          - id: gather-inbox-state
            actor: pm-agent
            label: gather inbox state
            skills: [agent-messaging]
          - id: gather-message-queue
            actor: pm-agent
            label: gather message queue
      - id: classify
        heuristics:
          - v_stale_concept
        work_steps:
          - id: classify-each-signal
            actor: pm-agent
            label: classify signals
            skills: [project-manager]
      - id: dispatch
        cross_links:
          - workflow: coding-session
            status: queued
            label: launch session
            kind: triggers
            pm_subagent_dispatch: true
          - workflow: coding-session
            status: executing
            label: relaunch crashed session
            kind: triggers
            pm_subagent_dispatch: true
          - workflow: pm-triage
            status: intake
            label: triage new inbound
            kind: triggers
            pm_subagent_dispatch: true
          - workflow: pm-incremental-update
            status: inspect
            label: handle agent question
            kind: triggers
            pm_subagent_dispatch: true
          - workflow: code-review
            status: received
            label: launch review on PR pair
            kind: triggers
            pm_subagent_dispatch: true
          - workflow: inbox-handling
            status: pending
            label: escalate to user
            kind: triggers
          - workflow: concept-freshness
            status: detected
            label: stale-node count high
            kind: triggers
        work_steps:
          - id: spawn-action
            actor: pm-agent
            label: dispatch matched signals
            skills: [project-manager]
      - id: idle
        work_steps:
          - id: wait-or-tick
            actor: pm-agent
            label: wait for next tick
            skills: [project-manager]
      - id: stopped
        terminal: true
    routes:
      - id: monitor-tick
        actor: pm-agent
        command: pm-monitor
        trigger: command.pm-monitor
        from: idle
        to: scan
        kind: forward
        label: tick
        skills: [project-manager]
      - id: scan-to-classify
        actor: pm-agent
        trigger: scan.complete
        from: scan
        to: classify
        kind: forward
        label: classify signals
        skills: [project-manager]
      - id: dispatch-launch-session
        actor: pm-agent
        from: classify
        to: dispatch
        trigger: signal.session_unblocked == true
        signals: [signal.session_unblocked]
        kind: forward
        label: launch unblocked session
        skills: [project-manager]
      - id: dispatch-relaunch
        actor: pm-agent
        from: classify
        to: dispatch
        trigger: signal.session_crashed == true
        signals:
          - signal.session_crashed
          - signal.session_paused_question
        kind: forward
        label: relaunch crashed or stuck
        skills: [project-manager]
      - id: dispatch-review
        actor: pm-agent
        from: classify
        to: dispatch
        trigger: signal.session_pr_pair_open == true
        signals: [signal.session_pr_pair_open]
        kind: forward
        label: launch code-review
        skills: [project-manager]
      - id: dispatch-triage
        actor: pm-agent
        from: classify
        to: dispatch
        trigger: signal.inbox_inbound_new == true
        signals:
          - signal.inbox_inbound_new
          - signal.comment_question
        kind: forward
        label: dispatch triage
        skills: [project-manager]
      - id: dispatch-idle
        actor: pm-agent
        from: classify
        to: idle
        trigger: signal.nothing_to_do == true
        signals: [signal.nothing_to_do]
        kind: side
        label: nothing to do
        skills: [project-manager]
      - id: dispatch-to-idle
        actor: pm-agent
        trigger: dispatch.complete
        from: dispatch
        to: idle
        kind: forward
        label: return to idle
        skills: [project-manager]
      - id: monitor-stop
        actor: pm-agent
        trigger: monitor.stop
        from: idle
        to: stopped
        kind: terminal
        label: stop monitor
        skills: [project-manager]

  # code-review — multi-reviewer cycle. Cross-cutting workflow that
  # takes a coding-session's PR pair through gate-check, three
  # independent reviews, synthesis, and either merge or relaunch.
  code-review:
    actor: pm-agent
    trigger: signal.session_pr_pair_open
    instance:
      storage_path: instances/reviews/{instance_id}/review.yaml
      status_field: status
      status_enum:
        - requested
        - in_review
        - approved
        - changes_requested
        - dismissed
        - completed
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: received
        tripwires:
          - v_freshness
        work_steps:
          - id: confirm-pr-pair
            actor: pm-agent
            label: confirm tripwire-pr + project-pr live
            skills: [project-manager]
      - id: gate-check
        tripwires:
          - v_artifact_presence
          - v_handoff_artifact
          - v_phase_requirements
        work_steps:
          - id: run-validate-on-branch
            actor: pm-agent
            label: validate on branch
            skills: [project-manager, verification]
          - id: walk-verification-checklist
            actor: pm-agent
            label: walk verification checklist
          - id: write-verified-md
            actor: pm-agent
            label: write verified.md
      - id: independent-reviews
        work_steps:
          - id: read-self-review
            actor: pm-agent
            label: read self-review.md
            skills: [project-manager]
          - id: launch-superpowers-subagent
            actor: pm-agent
            label: launch superpowers code-review subagent
          - id: comment-codex-trigger
            actor: pm-agent
            label: comment @codex on project-pr
          - id: collect-review-outputs
            actor: pm-agent
            label: collect three review outputs
      - id: synthesis
        jit_prompts:
          - self-review
        work_steps:
          - id: synthesize-findings
            actor: pm-agent
            label: synthesize three reviews
            skills: [project-manager]
          - id: decide-verdict
            actor: pm-agent
            label: decide merge or relaunch
      - id: node-reconcile
        cross_links:
          - workflow: concept-freshness
            status: detected
            label: trigger node refresh
            kind: triggers
        work_steps:
          - id: identify-touched-nodes
            actor: pm-agent
            label: identify touched nodes
            skills: [project-manager]
          - id: identify-missing-nodes
            actor: pm-agent
            label: identify missing nodes
          - id: update-or-create-nodes
            actor: pm-agent
            label: update or create nodes
          - id: rehash-source-nodes
            actor: pm-agent
            label: rehash source nodes
      - id: merge
        terminal: true
        tripwires:
          - v_done_implies_issue_artifacts_on_main
        work_steps:
          - id: merge-tripwire-pr
            actor: pm-agent
            label: merge tripwire-pr
            skills: [project-manager]
          - id: merge-project-pr
            actor: pm-agent
            label: merge project-pr
          - id: emit-merge-event
            actor: pm-agent
            label: emit merge event
      - id: relaunch
        terminal: true
        cross_links:
          - workflow: coding-session
            status: executing
            label: relaunch agent with findings
            kind: triggers
            pm_subagent_dispatch: true
        work_steps:
          - id: write-pm-followup-artifact
            actor: pm-agent
            label: write PM followup artifact
            skills: [project-manager]
          - id: session-reopen-and-resume
            actor: pm-agent
            label: reopen session and resume coding agent
    routes:
      - id: pr-pair-received
        actor: pm-agent
        trigger: signal.session_pr_pair_open == true
        signals: [signal.session_pr_pair_open]
        from: source:session.in_review
        to: received
        kind: forward
        label: receive PR pair
        skills: [project-manager]
      - id: pass-gate
        actor: pm-agent
        trigger: received.confirmed
        from: received
        to: gate-check
        kind: forward
        label: gate-check
        skills: [project-manager]
      - id: enter-reviews
        actor: pm-agent
        trigger: gate-check.passed
        from: gate-check
        to: independent-reviews
        kind: forward
        label: launch reviewers
        skills: [project-manager]
      - id: enter-synthesis
        actor: pm-agent
        trigger: reviews.collected
        from: independent-reviews
        to: synthesis
        kind: forward
        label: synthesize
        skills: [project-manager]
      - id: route-to-merge
        actor: pm-agent
        command: pm-session-review
        trigger: review.verdict == merge
        from: synthesis
        to: node-reconcile
        kind: forward
        label: route to merge
        controls:
          prompt_checks: [pm-session-review]
        skills: [project-manager]
      - id: route-to-relaunch
        actor: pm-agent
        command: pm-session-review
        trigger: review.verdict == relaunch
        from: synthesis
        to: relaunch
        kind: return
        label: route to relaunch
        controls:
          prompt_checks: [pm-session-review]
        skills: [project-manager]
      - id: do-merge
        actor: pm-agent
        trigger: node-reconcile.complete
        from: node-reconcile
        to: merge
        kind: forward
        label: merge PRs
        skills: [project-manager]

  inbox-handling:
    actor: pm-agent
    trigger: signal.inbox_inbound_new
    instance:
      storage_path: instances/triage-runs/{instance_id}/triage.yaml
      status_field: status
      status_enum: [pending, triaged, resolved]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: pending
        heuristics:
          - v_concept_name_prose
        work_steps:
          - id: receive-row
            actor: pm-agent
            label: receive inbox row
            skills: [project-manager, agent-messaging]
      - id: triaged
        tripwires:
          - v_reference_integrity
        prompt_checks: [pm-edit]
        work_steps:
          - id: classify-row
            actor: pm-agent
            label: classify and decide action
            skills: [project-manager]
      - id: resolved
        terminal: true
        work_steps:
          - id: close-row
            actor: pm-agent
            label: close inbox row
            skills: [project-manager]
    routes:
      - id: inbox-receive
        actor: pm-agent
        trigger: signal.inbox_inbound_new == true
        signals: [signal.inbox_inbound_new, signal.comment_question]
        from: source:inbox
        to: pending
        kind: forward
        label: receive
        skills: [project-manager]
      - id: inbox-triage
        actor: pm-agent
        command: pm-edit
        trigger: command.pm-edit
        from: pending
        to: triaged
        kind: forward
        label: triage
        skills: [project-manager]
      - id: inbox-resolve
        actor: pm-agent
        trigger: triage.action_taken
        from: triaged
        to: resolved
        kind: forward
        label: resolve
        skills: [project-manager]

  pr-lifecycle:
    actor: pm-agent
    trigger: pr.opened
    # PR state is GitHub-driven; this stub path is aspirational and
    # serves only as a validate-time contract anchor until the
    # executor materialises an instance file.
    instance:
      storage_path: instances/prs/{instance_id}/pr.yaml
      status_field: status
      status_enum:
        - draft
        - open
        - approved
        - changes_requested
        - merged
        - closed
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: draft
        work_steps:
          - id: open-draft
            actor: coding-agent
            label: open draft PR
            skills: [backend-development]
      - id: ready
        tripwires:
          - v_freshness
          - v_handoff_artifact
          - v_comment_provenance
        work_steps:
          - id: mark-ready
            actor: coding-agent
            label: mark ready for review
            skills: [agent-messaging]
      - id: reviewing
        cross_links:
          - workflow: code-review
            status: received
            label: review consumes PR pair
            kind: triggered_by
        work_steps:
          - id: under-review
            actor: pm-agent
            label: PR under review
            skills: [project-manager]
      - id: approved
        tripwires:
          - v_done_implies_issue_artifacts_on_main
        work_steps:
          - id: hold-approved
            actor: pm-agent
            label: ready to merge
            skills: [project-manager]
      - id: merged
        terminal: true
        work_steps:
          - id: emit-merge
            actor: pm-agent
            label: emit pr.merged event
            skills: [project-manager]
      - id: rejected
        terminal: true
        cross_links:
          - workflow: coding-session
            status: executing
            label: rejection re-enters execution
            kind: triggers
        work_steps:
          - id: hold-rejected
            actor: pm-agent
            label: rejected — relaunch session
            skills: [project-manager]
    routes:
      - id: pr-open
        actor: coding-agent
        trigger: pr.opened
        from: source:branch
        to: draft
        kind: forward
        label: open PR
        skills: [backend-development]
      - id: pr-ready
        actor: coding-agent
        trigger: pr.ready_for_review
        from: draft
        to: ready
        kind: forward
        label: mark ready
        skills: [backend-development]
      - id: pr-enter-review
        actor: pm-agent
        trigger: review.requested
        from: ready
        to: reviewing
        kind: forward
        label: enter review
        skills: [project-manager]
      - id: pr-approve
        actor: pm-agent
        trigger: review.outcome == approved
        from: reviewing
        to: approved
        kind: forward
        label: approve
        skills: [project-manager]
      - id: pr-reject
        actor: pm-agent
        trigger: review.outcome == changes_requested
        from: reviewing
        to: rejected
        kind: return
        label: reject
        skills: [project-manager]
      - id: pr-merge
        actor: pm-agent
        trigger: pr.merge
        from: approved
        to: merged
        kind: forward
        label: merge
        skills: [project-manager]

  phase-advancement:
    actor: pm-agent
    trigger: command.pm-phase
    # Phase lives on project.yaml itself (singleton instance — there
    # is one project, one phase). `instance_id` is the project name;
    # the executor reads/writes project.yaml.phase directly.
    instance:
      storage_path: project.yaml
      status_field: phase
      status_enum: [scoping, scoped, executing, reviewing]
      required_fields: [phase]
      instance_id_field: name
    statuses:
      - id: scoping
        work_steps:
          - id: in-scoping
            actor: pm-agent
            label: scoping phase work
            skills: [project-manager]
      - id: scoped
        tripwires:
          - v_phase_requirements
        work_steps:
          - id: in-scoped
            actor: pm-agent
            label: scoped — ready to execute
            skills: [project-manager]
      - id: executing
        work_steps:
          - id: in-executing
            actor: pm-agent
            label: executing phase work
            skills: [project-manager]
      - id: reviewing
        terminal: true
        tripwires:
          - v_done_implies_issue_artifacts_on_main
        work_steps:
          - id: in-reviewing
            actor: pm-agent
            label: reviewing phase work
            skills: [project-manager]
    routes:
      - id: advance-to-scoped
        actor: pm-agent
        command: pm-phase
        trigger: command.pm-phase
        from: scoping
        to: scoped
        kind: forward
        label: advance to scoped
        skills: [project-manager]
      - id: advance-to-executing
        actor: pm-agent
        command: pm-phase
        trigger: command.pm-phase
        from: scoped
        to: executing
        kind: forward
        label: advance to executing
        skills: [project-manager]
      - id: advance-to-reviewing
        actor: pm-agent
        command: pm-phase
        trigger: command.pm-phase
        from: executing
        to: reviewing
        kind: forward
        label: advance to reviewing
        skills: [project-manager]

  issue-closure:
    actor: pm-agent
    trigger: command.pm-issue-close
    instance:
      storage_path: instances/issues/{instance_id}/issue.yaml
      status_field: status
      status_enum:
        - planned
        - queued
        - executing
        - in_review
        - verified
        - completed
        - abandoned
        - deferred
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: planned
        tripwires:
          - v_done_implies_issue_artifacts_on_main
        work_steps:
          - id: ready
            actor: pm-agent
            label: declare the issue ready
            skills: [project-manager]
      - id: queued
        work_steps:
          - id: enqueue
            actor: pm-agent
            label: queue for execution
            skills: [project-manager]
      - id: executing
        work_steps:
          - id: execute
            actor: coding-agent
            label: code the issue
            skills: [backend-development]
      - id: in_review
        tripwires:
          - v_issue_artifact_presence
        work_steps:
          - id: review
            actor: pm-agent
            label: review the code
            skills: [verification]
      - id: verified
        tripwires:
          - v_issue_artifact_presence
        work_steps:
          - id: verified
            actor: pm-agent
            label: verification complete
            skills: [verification]
      - id: completed
        terminal: true
        tripwires:
          - v_done_implies_issue_artifacts_on_main
          - v_done_implies_session_completed
        work_steps:
          - id: closed
            actor: pm-agent
            label: emit closure event
            skills: [project-manager]
      - id: abandoned
        terminal: true
        work_steps:
          - id: abandon
            actor: pm-agent
            label: abandon the issue
            skills: [project-manager]
      - id: deferred
        work_steps:
          - id: defer
            actor: pm-agent
            label: defer the issue
            skills: [project-manager]
    routes:
      # Forward path
      - id: issue-plan-to-queue
        actor: pm-agent
        from: planned
        to: queued
        kind: forward
        label: queue
        skills: [project-manager]
      - id: issue-queue-to-execute
        actor: pm-agent
        from: queued
        to: executing
        kind: forward
        label: begin execution
        skills: [project-manager]
      - id: issue-execute-to-review
        actor: coding-agent
        from: executing
        to: in_review
        kind: forward
        label: send to review
        skills: [project-manager]
      - id: issue-review-to-verified
        actor: pm-agent
        from: in_review
        to: verified
        kind: forward
        label: pass review
        skills: [verification]
      - id: issue-verified-to-completed
        actor: pm-agent
        command: pm-issue-close
        trigger: command.pm-issue-close
        from: verified
        to: completed
        kind: forward
        label: close issue
        skills: [project-manager]
        controls:
          prompt_checks: [pm-issue-close]

      # Reverse / loop / side edges
      - id: issue-review-back-to-execute
        actor: pm-agent
        from: in_review
        to: executing
        kind: return
        label: changes requested
        skills: [project-manager]
      - id: issue-verified-back-to-review
        actor: pm-agent
        from: verified
        to: in_review
        kind: return
        label: re-review
        skills: [project-manager]

      # Abandon edges (any non-terminal status)
      - id: issue-abandon-from-planned
        actor: pm-agent
        from: planned
        to: abandoned
        kind: terminal
        label: abandon (planned)
        skills: [project-manager]
      - id: issue-abandon-from-queued
        actor: pm-agent
        from: queued
        to: abandoned
        kind: terminal
        label: abandon (queued)
        skills: [project-manager]
      - id: issue-abandon-from-executing
        actor: pm-agent
        from: executing
        to: abandoned
        kind: terminal
        label: abandon (executing)
        skills: [project-manager]
      - id: issue-abandon-from-review
        actor: pm-agent
        from: in_review
        to: abandoned
        kind: terminal
        label: abandon (in_review)
        skills: [project-manager]
      - id: issue-abandon-from-verified
        actor: pm-agent
        from: verified
        to: abandoned
        kind: terminal
        label: abandon (verified)
        skills: [project-manager]

      # Defer edges
      - id: issue-defer-from-planned
        actor: pm-agent
        from: planned
        to: deferred
        kind: side
        label: defer
        skills: [project-manager]
      - id: issue-defer-from-queued
        actor: pm-agent
        from: queued
        to: deferred
        kind: side
        label: defer
        skills: [project-manager]
      - id: issue-defer-from-executing
        actor: pm-agent
        from: executing
        to: deferred
        kind: side
        label: defer
        skills: [project-manager]

      # Resume from deferred
      - id: issue-deferred-back-to-planned
        actor: pm-agent
        from: deferred
        to: planned
        kind: forward
        label: resume
        skills: [project-manager]
      - id: issue-deferred-to-abandoned
        actor: pm-agent
        from: deferred
        to: abandoned
        kind: terminal
        label: abandon (deferred)
        skills: [project-manager]

  # concept-freshness — periodic node-staleness sweep. Mostly handled
  # by validate's `v_stale_concept` heuristic; this declaration is the
  # contract for when a future executor materialises a sweep instance.
  concept-freshness:
    actor: pm-agent
    trigger: signal.stale_node_count_high
    instance:
      storage_path: instances/nodes/{instance_id}.yaml
      status_field: status
      status_enum: [active, stale, archived]
      required_fields: [id, status]
      instance_id_field: id
    statuses:
      - id: detected
        heuristics:
          - v_stale_concept
        work_steps:
          - id: scan-nodes
            actor: pm-agent
            label: scan for stale nodes
            skills: [project-manager]
      - id: refreshed
        terminal: true
        work_steps:
          - id: emit-refresh
            actor: pm-agent
            label: emit refresh event
            skills: [project-manager]
    routes:
      - id: freshness-scan
        actor: pm-agent
        trigger: signal.stale_node_count_high == true
        signals: [signal.stale_node_count_high]
        from: source:graph
        to: detected
        kind: forward
        label: scan
        skills: [project-manager]
      - id: freshness-refresh
        actor: pm-agent
        trigger: refresh.complete
        from: detected
        to: refreshed
        kind: forward
        label: refreshed
        skills: [project-manager]
