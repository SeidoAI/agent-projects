# Per-project workflow definitions (v0.13 schema).
#
# Routes are the single source of structural arrows. Status nodes
# declare territory (artifacts produced/consumed, controls fired on
# entry); routes declare transitions with their gates, side-effects,
# and rollback policy. The executor (`tripwire.core.workflow.transitions`)
# is the SOLE writer of `session.status` — every direct mutation in
# the codebase routes through `execute_transition` with a route id.
#
# Conditional triggers are equality only (`==`, `!=`). Predicate
# fields are dot-paths into the workflow context.
#
# Other named workflows from earlier releases (pm-scoping, pm-triage,
# code-review, etc.) are documentation only and now live under
# `docs/workflows/reference-only-workflows.md`. They have no executor
# coverage and were drift hazards while declared here.

workflow_schema_version: 1

workflows:
  coding-session:
    actor: coding-agent
    trigger: session.spawn
    brief-description: "one session: plan, execute, review, ship."
    statuses:
      - id: planned
        artifacts:
          consumes:
            - id: issue-brief
              label: issue brief
          produces:
            - id: plan
              label: plan.md
              path: sessions/{session_id}/artifacts/plan.md
            - id: verification-checklist
              label: verification-checklist.md
              path: sessions/{session_id}/artifacts/verification-checklist.md
        work_steps:
          - id: plan
            actor: pm-agent
            label: write plan + verification checklist
            skills: [project-manager, verification]
      - id: queued
        artifacts:
          consumes:
            - id: plan
              label: plan.md
            - id: verification-checklist
              label: verification-checklist.md
        work_steps:
          - id: dispatch
            actor: pm-agent
            label: dispatch when unblocked
            skills: [project-manager]
      - id: executing
        artifacts:
          consumes:
            - id: plan
              label: plan.md
            - id: verification-checklist
              label: verification-checklist.md
          produces:
            - id: diff
              label: implementation diff
            - id: task-checklist
              label: task-checklist.md
              path: sessions/{session_id}/artifacts/task-checklist.md
            - id: self-review
              label: self-review.md
              path: sessions/{session_id}/artifacts/self-review.md
            - id: recommended-testing-plan
              label: recommended-testing-plan.md
              path: sessions/{session_id}/artifacts/recommended-testing-plan.md
            - id: post-completion-comments
              label: post-completion-comments.md
              path: sessions/{session_id}/artifacts/post-completion-comments.md
            - id: developer-doc
              label: developer.md
              path: issues/{issue_key}/developer.md
            - id: tripwire-pr
              label: tripwire-repo PR
            - id: project-pr
              label: project-repo PR
        work_steps:
          - id: monitor
            actor: pm-agent
            label: monitor execution
            skills: [project-manager]
          - id: implement
            actor: coding-agent
            label: implement
            skills: [backend-development, agent-messaging]
          - id: deliver
            actor: coding-agent
            label: open PRs + self-review
            skills: [verification]
      - id: in_review
        artifacts:
          consumes:
            - id: diff
              label: implementation diff
            - id: self-review
              label: self-review.md
            - id: task-checklist
              label: task-checklist.md
            - id: recommended-testing-plan
              label: recommended-testing-plan.md
            - id: tripwire-pr
              label: tripwire-repo PR
            - id: project-pr
              label: project-repo PR
          produces:
            - id: pm-response
              label: pm-response.yaml
              path: sessions/{session_id}/artifacts/pm-response.yaml
        work_steps:
          - id: review
            actor: pm-agent
            label: review session
            skills: []
      - id: verified
        artifacts:
          consumes:
            - id: pm-response
              label: pm-response.yaml
            - id: self-review
              label: self-review.md
          produces:
            - id: completion-comment
              label: completion-comment.yaml
              path: issues/{issue_key}/comments/{nnn}-completion-{yyyy-mm-dd}.yaml
        work_steps:
          - id: close-out
            actor: pm-agent
            label: write completion comment
            skills: [project-manager, agent-messaging]
      - id: completed
        terminal: true
        artifacts:
          consumes:
            - id: tripwire-pr
              label: tripwire-repo PR
            - id: project-pr
              label: project-repo PR
          produces:
            - id: session-signature
              label: session signature
        work_steps:
          - id: sign
            actor: code
            label: sign session
            skills: []
      - id: paused
      - id: failed
      - id: abandoned
        terminal: true
    routes:
      # Forward path
      - id: session-create
        actor: pm-agent
        command: pm-session-create
        trigger: command.pm-session-create
        from: source:issue
        to: planned
        kind: forward
        label: create session
        controls:
          prompt_checks: [pm-session-create]
          tripwires:
            - v_workflow_well_formed
            - v_uuid_present
            - v_id_format
            - v_enum_values
            - v_id_collisions
            - v_timestamps
          heuristics:
            - v_sequence_drift
        skills: [project-manager]
        emits:
          artifacts:
            - id: session-yaml
              label: session.yaml
      - id: planned-to-queued
        actor: pm-agent
        command: pm-session-queue
        trigger: command.pm-session-queue
        from: planned
        to: queued
        kind: forward
        label: queue session
        controls:
          prompt_checks: [pm-session-queue]
          tripwires:
            - v_session_issue_coherence
            - v_issue_session_status_compatibility
            - v_reference_integrity
            - v_bidirectional_related
            - v_no_stale_pins
            - v_status_transitions
        skills: [project-manager]
        side_effects: [sweep_issues_forward]
        emits:
          artifacts:
            - id: plan
              label: plan.md
      - id: queued-to-executing
        actor: pm-agent
        command: pm-session-spawn
        trigger: command.pm-session-spawn
        from: queued
        to: executing
        kind: forward
        label: spawn coding agent
        controls:
          prompt_checks: [pm-session-spawn]
          tripwires:
            - v_issue_body_structure
            - v_project_standards
            - v_freshness
            - v_comment_provenance
            - v_handoff_artifact
            - v_worktree_paths_unique
            - v_no_orphan_proj_branches
            - v_done_implies_session_completed
          heuristics:
            - v_stale_concept
            - v_concept_name_prose
            - v_semantic_coverage
            - v_mega_issue
            - v_node_ratio
        skills: [project-manager, backend-development, agent-messaging]
        emits:
          events: [session.spawn]
      - id: executing-to-in_review
        actor: coding-agent
        trigger: command.tripwire-session-complete
        from: executing
        to: in_review
        kind: forward
        label: submit for review
        controls:
          tripwires:
            - v_manifest_schema
            - v_manifest_phase_ownership_consistent
            - v_artifact_presence
            - v_phase_requirements
            - v_issue_artifact_presence
          heuristics:
            - v_coverage_heuristics
            - v_quality_consistency
        skills: [backend-development, agent-messaging]
        side_effects: [sweep_issues_forward, rebase_pt_branch]
        emits:
          artifacts:
            - id: diff
              label: implementation diff
      - id: review-approved
        actor: pm-agent
        command: pm-session-review
        trigger: review.outcome == approved
        from: in_review
        to: verified
        kind: forward
        label: approve review
        controls:
          prompt_checks: [pm-session-review]
        skills: [project-manager, verification]
        side_effects: [sweep_issues_forward]
        emits:
          artifacts:
            - id: review-notes
              label: review notes
      - id: review-changes-requested
        actor: pm-agent
        command: pm-session-review
        trigger: review.outcome == changes_requested
        from: in_review
        to: executing
        kind: revert
        label: request changes
        skills: [project-manager, verification, backend-development]
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: verified-to-in_review
        actor: pm-agent
        from: verified
        to: in_review
        kind: revert
        label: re-open review (verified→in_review)
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: verified-to-completed
        actor: pm-agent
        command: pm-session-complete
        trigger: command.pm-session-complete
        from: verified
        to: completed
        kind: forward
        label: complete session
        controls:
          prompt_checks: [pm-session-complete]
          tripwires:
            - v_pm_response_covers_self_review
            - v_pm_response_followups_resolve
            - v_done_implies_issue_artifacts_on_main
            - v_self_review_implies_pm_response
          jit_prompts:
            - self-review
            - phase-transition
            - followups-not-filed
            - stopped-to-ask
            - write-count
            - cost-ceiling
        skills: [project-manager, verification]
        side_effects:
          - verify_prs_merged
          - verify_review_ok
          - verify_issue_artifacts
          - flip_drafts_to_ready
          - sweep_issues_forward
          - remove_worktrees
          - append_telemetry_row
        emits:
          artifacts:
            - id: session-signature
              label: session signature

      # Side-state edges (off-path). These routes are triggered by CLI
      # commands (`tripwire session pause/abandon/reopen`) or runtime
      # events (e.g. process exit) — not by slash-command invocations,
      # so they do not declare `command:` (no prompt-check coverage).
      - id: executing-to-paused
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-pause
        from: executing
        to: paused
        kind: side
        label: pause execution
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: executing-to-failed
        actor: code
        trigger:
          type: runtime_event
          name: process_exited
        from: executing
        to: failed
        kind: side
        label: runtime exited unexpectedly
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: paused-to-executing
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-spawn-resume
        from: paused
        to: executing
        kind: forward
        label: resume from paused
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: failed-to-executing
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-spawn-resume
        from: failed
        to: executing
        kind: forward
        label: resume from failed
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
      - id: paused-to-queued
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-requeue
        from: paused
        to: queued
        kind: revert
        label: re-queue paused session (PM-handoff #5 Gap C fix)
        preserve_fields:
          - runtime_state.claude_session_id
      - id: paused-to-completed
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-unreopen
        from: paused
        to: completed
        kind: revert
        label: never mind, leave completed (PM-handoff #5 Gap D fix)
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees

      # Reopen (completed → paused) — PM-handoff #5 Gap A path.
      - id: completed-to-paused-reopen
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-reopen
        from: completed
        to: paused
        kind: revert
        label: reopen completed session
        preserve_fields:
          - runtime_state.claude_session_id
          - runtime_state.worktrees
        side_effects:
          - flip_drafts_to_draft
          - append_pm_followup_stub
          - reset_acks
          - append_audit_log_entry
        emits:
          events: [session.reopened]

      # Abandon edges from every non-terminal status. Triggered by
      # `tripwire session abandon` (CLI), not a slash command.
      - id: planned-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: planned
        to: abandoned
        kind: side
        label: abandon (planned)
      - id: queued-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: queued
        to: abandoned
        kind: side
        label: abandon (queued)
      - id: executing-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: executing
        to: abandoned
        kind: side
        label: abandon (executing)
        side_effects:
          - kill_runtime
          - close_open_prs
          - remove_worktrees
      - id: paused-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: paused
        to: abandoned
        kind: side
        label: abandon (paused)
        side_effects:
          - close_open_prs
          - remove_worktrees
      - id: failed-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: failed
        to: abandoned
        kind: side
        label: abandon (failed)
        side_effects:
          - close_open_prs
          - remove_worktrees
      - id: in_review-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: in_review
        to: abandoned
        kind: side
        label: abandon (in_review)
        side_effects:
          - close_open_prs
          - remove_worktrees
      - id: verified-to-abandoned
        actor: pm-agent
        trigger:
          type: command
          name: tripwire-session-abandon
        from: verified
        to: abandoned
        kind: side
        label: abandon (verified)
        side_effects:
          - close_open_prs
          - remove_worktrees
